{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ingestion": {
    "BufferCapacity": 10000,
    "DeduplicationWindowSeconds": 10,
    "IdleTimeoutSeconds": 15,
    "ReconnectInitialDelaySeconds": 1,
    "ReconnectMaxDelaySeconds": 30
  },
  "Exchanges": [
    {
      "Name": "binance-style",
      "Endpoint": "ws://localhost:5001/ticks",
      "Format": "BinanceStyle"
    },
    {
      "Name": "coinbase-style",
      "Endpoint": "ws://localhost:5002/ticks",
      "Format": "CoinbaseStyle"
    },
    {
      "Name": "custom",
      "Endpoint": "ws://localhost:5003/ticks",
      "Format": "Custom"
    }
  ]
}
