{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ingestion": {
    "BufferCapacity": 10000,
    "DeduplicationWindowSeconds": 10,
    "IdleTimeoutSeconds": 15,
    "ReconnectInitialDelaySeconds": 1,
    "ReconnectMaxDelaySeconds": 30
  },
  "Persistence": {
    "ConnectionString": "Host=127.0.0.1;Port=15432;Database=ticks;Username=aggregator;Password=aggregator",
    "BatchSize": 500,
    "FlushIntervalMilliseconds": 1000,
    "MaxWriteAttempts": 3,
    "DrainTimeoutMilliseconds": 5000
  },
  "Exchanges": [
    {
      "Name": "binance-style",
      "Endpoint": "ws://localhost:5001/ticks",
      "Format": "BinanceStyle"
    },
    {
      "Name": "coinbase-style",
      "Endpoint": "ws://localhost:5002/ticks",
      "Format": "CoinbaseStyle"
    },
    {
      "Name": "custom",
      "Endpoint": "ws://localhost:5003/ticks",
      "Format": "Custom"
    }
  ]
}
